# -----------------------------------------------------------------------------
# Leegend Cars — variables d'environnement
# Copie ce fichier en « .env » (il est ignoré par Git, ne jamais le versionner).
# -----------------------------------------------------------------------------

# --- Base de données Supabase ----------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI
# Choisis le mode « Session pooler » (port 5432) : il fonctionne en IPv4.
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Storage (photos véhicules + pièces jointes) ------------------
# Supabase > Project Settings > API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Session administrateur -------------------------------------------------
# Secret de signature des cookies. Génère-le une seule fois avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=colle_ici_un_texte_aleatoire_de_64_caracteres

# --- Divers ----------------------------------------------------------------
# NODE_ENV=production
# PORT=3000